{
  "name": "savia-coffee",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev:pages": "vite --config vite.pages.config.ts",
    "build:pages": "tsc --noEmit && vite build --config vite.pages.config.ts && node scripts/precache-pages.mjs",
    "preview:pages": "vite preview --config vite.pages.config.ts",
    "test": "node scripts/check-coffee.mjs"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "lucide-react": "1.31.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "tailwindcss": "4.2.1",
    "@tailwindcss/postcss": "4.2.1"
  }
}
